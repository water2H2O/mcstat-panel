{
  "name": "@local/mcstat-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only Minecraft server status panel for the DeepSeek Harness Web UI: the mcstat command, as a page.",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "minecraft", "server", "dashboard", "systemd"],
  "license": "MIT",
  "author": "water2H2O",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
