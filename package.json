{
  "name": "@local/mcstat-panel",
  "version": "1.2.0",
  "private": true,
  "description": "Minecraft server panel for the DeepSeek Harness Web UI: live status, server control, editable settings, log stream, and DS-assisted checks.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "minecraft",
    "server",
    "dashboard",
    "systemd"
  ],
  "license": "MIT",
  "author": "water2H2O",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/water2H2O/mcstat-panel.git"
  },
  "homepage": "https://github.com/water2H2O/mcstat-panel#readme"
}
